#!/usr/bin/with-contenv bash

ip link del dev test 2>/dev/null
if ip link add dev test type wireguard; then
  ip link del dev test
else
  echo "[$(date -Iseconds)] The wireguard module is not active, try \`docker run --rm --cap-add=NET_ADMIN --cap-add=SYS_MODULE -v /lib/modules:/lib/modules bubuntux/install-wireguard\` to install it or follow the proper instructions from https://www.wireguard.com/install/ to manually install it."
  sleep infinity
fi

if ! iptables-nft -L > /dev/null 2>&1; then
  echo "[$(date -Iseconds)] iptables-nft is not functional. Ensure your container config adds --cap-add=NET_RAW"
  sleep infinity
fi

if ! ip6tables-nft -L > /dev/null 2>&1; then
  if ip -6 route show default 2>/dev/null | grep -q default; then
    echo "[$(date -Iseconds)] ERROR: ip6tables-nft is not functional but the container has an IPv6 default route (global IPv6 egress is possible). Refusing to start without an IPv6 kill switch. Ensure the host kernel supports IPv6 and the container config adds --cap-add=NET_ADMIN."
    sleep infinity
  else
    echo "[$(date -Iseconds)] WARNING: ip6tables-nft is not functional; the container has no IPv6 default route, so the IPv6 kill switch cannot be applied (no IPv6 connectivity to protect)."
  fi
fi

if [[ -z ${PRIVATE_KEY} ]] && [[ -z ${PRIVATE_KEY_FILE} ]] ; then
  echo "[$(date -Iseconds)] Missing PRIVATE_KEY and PRIVATE_KEY_FILE. Try \`docker run --rm --cap-add=NET_ADMIN -e TOKEN=XXX bubuntux/nordvpn:get_private_key\` with an access token, or follow these instructions to obtain the private key: https://forum.openwrt.org/t/instruction-config-nordvpn-wireguard-nordlynx-on-openwrt/89976"
  sleep infinity
fi
