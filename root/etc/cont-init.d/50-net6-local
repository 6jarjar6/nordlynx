#!/usr/bin/with-contenv bash

iface=${INTERFACE:-eth0}
if [ -n "$NET6_LOCAL" ]; then
   gw="$(ip -6 route | awk '/default/{print $3}')"
   for net in ${NET6_LOCAL//[;,]/ }; do
     echo "[$(date -Iseconds)] Enabling connection to network ${net}"
      if [ -n "$gw" ]; then
        ip -6 route | grep -q "$net" || ip -6 route add "$net" via "$gw" dev "$iface"
      fi
      ip6tables-nft -A INPUT   -i "$iface" -s "$net" -j ACCEPT
      ip6tables-nft -A OUTPUT  -o "$iface" -d "$net" -j ACCEPT
      ip6tables-nft -A FORWARD -i "$iface" -d "$net" -j ACCEPT
      ip6tables-nft -A FORWARD -i "$iface" -s "$net" -j ACCEPT
  done
fi
