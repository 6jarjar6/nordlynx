#!/usr/bin/with-contenv bash

if [[ -z ${PUBLIC_KEY} || -z ${END_POINT} ]]; then
  echo "[$(date -Iseconds)] Finding the best server... (best server near you; the recommendation API is geo-personalized)"
  tech_filter="filters[servers_technologies][identifier]=wireguard_udp"

  # limit/offset are the only two knobs the recommendations endpoint honors.
  limit=${LIMIT:-1}
  offset=${OFFSET:-0}

  # Assemble the query. Append fragments only when they are supplied.
  api_url="https://api.nordvpn.com/v1/servers/recommendations?${tech_filter}&limit=${limit}&offset=${offset}"
  if [[ -n ${QUERY} ]]; then
    api_url="${api_url}&${QUERY}"
  fi
  echo "[$(date -Iseconds)] API URL: ${api_url}"

  # Retry the selection. The API can be transiently unavailable, and a single
  # failure should not kill the container.
  retry_delay=${NO_CONNECTION_RETRY:-5}
  n=0
  while :; do
    n=$((n + 1))
    recommendations=$(curl --retry 3 --show-error -L -s --globoff "${api_url}")
    if [[ -n ${recommendations} ]] && jq -e 'length > 0' <<<"${recommendations}" >/dev/null 2>&1; then
      break
    fi
    echo "[$(date -Iseconds)] WARNING: no server returned (attempt ${n}). Retrying in ${retry_delay}s."
    sleep "${retry_delay}"
  done

  server=$(jq -r '.[0] | del(.services, .technologies)' <<< "${recommendations}")
  echo "[$(date -Iseconds)] Server: ${server}"
  if [[ -z ${PUBLIC_KEY} ]]; then
    PUBLIC_KEY=$(jq -r '.[0].technologies[] | select( .identifier == "wireguard_udp" ) | .metadata[] | select( .name == "public_key" ) | .value' <<< "${recommendations}")
  fi
  if [[ -z ${END_POINT} ]]; then
    END_POINT=$(jq -r '.[0].hostname' <<< "${recommendations}"):51820
  fi
fi

[[ -z "${PRIVATE_KEY}" ]] && [[ -f "${PRIVATE_KEY_FILE}" ]] && PRIVATE_KEY="$(head -n 1 "${PRIVATE_KEY_FILE}")"

( umask 077 && {
  {
    echo "[Interface]"
    echo "PrivateKey = ${PRIVATE_KEY}"
    echo "ListenPort = ${LISTEN_PORT:-51820}"
    echo "Address = ${ADDRESS:-10.5.0.2/32}"
    if [[ -n ${TABLE} ]]; then echo "Table = ${TABLE}"; fi
    if [[ -n ${PRE_UP} ]]; then echo "PreUp = ${PRE_UP}"; fi
    if [[ -n ${POST_UP} ]]; then echo "PostUp = ${POST_UP}"; fi
    if [[ -n ${PRE_DOWN} ]]; then echo "PreDown = ${PRE_DOWN}"; fi
    if [[ -n ${POST_DOWN} ]]; then echo "PostDown = ${POST_DOWN}"; fi
    echo ""
    echo "[Peer]"
    echo "Endpoint = ${END_POINT}"
    echo "PublicKey = ${PUBLIC_KEY}"
    echo "AllowedIPs = ${ALLOWED_IPS:-0.0.0.0/0}"
    echo "PersistentKeepalive = ${PERSISTENT_KEEP_ALIVE:-25}"
  } > /etc/wireguard/wg0.conf
  sync
})

echo "[$(date -Iseconds)] Connecting..."
while :; do
  if wg-quick up wg0; then
    break
  fi
  echo "[$(date -Iseconds)] ERROR: wg-quick up failed. Retrying in ${NO_CONNECTION_RETRY:-5}s."
  sleep "${NO_CONNECTION_RETRY:-5}"
done

# Configure DNS directly. wg-quick's built-in resolvconf hook is incompatible
# with Docker-managed /etc/resolv.conf (signature mismatch on newer alpine
# resolvconf), and under set -e it aborts the bring-up and tears the
# interface down.
dns=${DNS:-103.86.96.100,103.86.99.100}
{
  echo "# Managed by nordlynx"
  tr ',' '\n' <<< "${dns}" | sed 's/^/nameserver /'
} > /etc/resolv.conf
echo "[$(date -Iseconds)] DNS configured: ${dns//,/ }"

echo "[$(date -Iseconds)] Connected! \(ᵔᵕᵔ)/"

# ---------------------------------------------------------------------------
# Post-connect supervision.
#
# A wg-quick up that succeeds at startup does not guarantee the tunnel stays
# alive. If the peer dies (server restart, host reboot, WAN fault), the tunnel
# goes dark silently. The default-deny policy still protects, but the
# ESTABLISHED,RELATED output window is open: established connections can keep
# riding eth0. Supervise the latest handshake; when it stalls (older than
# DEAD_SECONDS, or never occurred) the tunnel is dead:
#   1. conntrack -F  — flush all established state so the
#                      ESTABLISHED,RELATED rule matches nothing and the
#                      default-deny policy closes the leak (fail-closed).
#   2. wg-quick up   — re-establish the tunnel.
# RESPECT_RECONNECT: if RECONNECT is set, hand off to the supervisor after that
# many seconds (it restarts the service and reselects the server).
# ---------------------------------------------------------------------------
dead_seconds=120        # ~4.8x the 25s PersistentKeepAlive
check_interval=15
cooldown=60             # min gap between forced re-establishments (anti-flap)

have_timer=0
if [[ -n ${RECONNECT} ]] && [[ ${RECONNECT} =~ ^[0-9]+$ ]]; then
  have_timer=1
fi
if (( have_timer )); then
  echo "[$(date -Iseconds)] Reconnecting in ${RECONNECT} seconds (supervising the tunnel in the meantime)"
fi

WG_WATCHDOG_EPOCH_SECS=0
last_resurrect=0
while :; do
  sleep "${check_interval}"

  if (( have_timer )); then
    # Approximate elapsed time; the supervisor restarts the service, so we
    # only need to hand off once RECONNECT seconds have passed.
    WG_WATCHDOG_EPOCH_SECS=$((WG_WATCHDOG_EPOCH_SECS + check_interval))
    if (( WG_WATCHDOG_EPOCH_SECS >= RECONNECT )); then
      break
    fi
  fi

  # Parse the latest handshake as an absolute epoch (robust to the compound
  # "N minutes, N seconds ago" human format that 'wg show' can emit).
  hs_epoch=$(wg show wg0 latest-handshakes 2>/dev/null | awk '{print $2}' | sort -rn | head -1)
  now=$(date +%s)
  if [ -z "$hs_epoch" ] || [ "$hs_epoch" -lt 1 ]; then
    age=999999              # never handshake
  else
    age=$((now - hs_epoch))
    (( age < 0 )) && age=0  # clock wound backward
  fi
  # If the tunnel interface is gone, treat it as dead
  if ! ip link show wg0 2>/dev/null; then
    age=999999              # interface gone
  fi

  if [[ ${age} =~ ^[0-9]+$ ]] && (( age > dead_seconds )); then
    now_ts=$(date +%s)
    if (( now_ts - ${last_resurrect} >= cooldown )); then
      echo "[$(date -Iseconds)] ERROR: tunnel dead (last handshake ${age}s ago). Flushing conntrack (fail-closed) and re-establishing."
      conntrack -F 2>/dev/null || echo "[$(date -Iseconds)] WARNING: conntrack flush failed (missing conntrack or NET_ADMIN)."
      last_resurrect=$now_ts
      # Re-establish. wg-quick up fails if the interface already exists (the
      # common case: peer dead but wg0 still present), so tear it down first,
      # ignoring errors when the interface is already gone, then bring it up.
      wg-quick down wg0 2>/dev/null || true
      wg-quick up wg0 || echo "[$(date -Iseconds)] WARNING: re-establishment failed. Will keep supervising."
    fi
  fi
done
